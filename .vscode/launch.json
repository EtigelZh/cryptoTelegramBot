{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Attach",
        "type": "pwa-node",
        "request": "attach",
        "port": 9229,
        "skipFiles": ["<node_internals>/**"],
        "sourceMaps": true,
        "outFiles": ["${workspaceFolder}/dist/apps/crypto-investing-bot/main.js"],
        "sourceMapPathOverrides": {
          "webpack:///*": "${workspaceFolder}/*",
          "webpack:///./src/*": "${workspaceFolder}/apps/crypto-investing-bot/src/*"
        }
      }
    ]
  }