{
  "name": "crypto-investing-bot",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/crypto-investing-bot/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/crypto-investing-bot",
        "main": "apps/crypto-investing-bot/src/main.ts",
        "tsConfig": "apps/crypto-investing-bot/tsconfig.app.json",
        "assets": [
          "apps/crypto-investing-bot/src/assets"
        ],
        "webpackConfig": "apps/crypto-investing-bot/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {},
        "data-source": {
          "main": "./apps/crypto-investing-bot/src/data-source.ts"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "crypto-investing-bot:build",
        "inspect": true,
        "port": 9229
      },
      "configurations": {
        "development": {
          "buildTarget": "crypto-investing-bot:build:development",
          "inspect": true,
          "port": 9229
        },
        "production": {
          "buildTarget": "crypto-investing-bot:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/crypto-investing-bot/jest.config.ts"
      }
    }
  },
  "tags": []
}
